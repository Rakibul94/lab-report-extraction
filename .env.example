

# Copy to .env to switch from mock to a real OCR engine. Never commit .env.
# Default (no file) = mock: replayed recordings, no binary, no downloads.

LAB_PROVIDER=easyocr          # mock | easyocr



# --- easyocr: pip-only; downloads ~80 MB weights on FIRST start ---
# LAB_PROVIDER=easyocr
# LAB_EASYOCR_LANGS=en,bn
# LAB_EASYOCR_GPU=false
# LAB_EASYOCR_MAX_SIDE=1280
# LAB_EASYOCR_MODEL_DIR=
# LAB_EASYOCR_DOWNLOAD=true